# AutoFlow AI Configuration
# Database (defaults to SQLite in ./storage/autoflow.db; for PostgreSQL use: postgresql://user:pass@localhost:5432/autoflow)
DATABASE_URL=sqlite:///./storage/autoflow.db

# MLflow Local Tracking Store
MLFLOW_TRACKING_URI=./mlruns

# Allowed CORS Origins (comma separated in JSON array)
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000","http://127.0.0.1:3000"]

# Maximum File Upload Size in Bytes (50 MB)
MAX_UPLOAD_SIZE_BYTES=52428800

# Default Optuna Hyperparameter Trials
DEFAULT_OPTUNA_TRIALS=10
MAX_OPTUNA_TRIALS=50

# Monitoring & Drift Detection Thresholds
DEFAULT_DRIFT_THRESHOLD_PVALUE=0.05
LATENCY_WARNING_MS=250.0
